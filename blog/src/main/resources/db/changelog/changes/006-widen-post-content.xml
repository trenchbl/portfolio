<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-widen-post-content" author="blog">
        <modifyDataType tableName="posts" columnName="content" newDataType="MEDIUMTEXT"/>
        <!-- On MySQL, modifyDataType rewrites the whole column definition and drops NOT NULL -->
        <addNotNullConstraint tableName="posts" columnName="content" columnDataType="MEDIUMTEXT"/>
    </changeSet>

</databaseChangeLog>
