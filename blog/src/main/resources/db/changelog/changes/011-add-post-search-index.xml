<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- createIndex has no FULLTEXT option, so this is plain MySQL -->
    <changeSet id="011-add-post-search-index" author="blog">
        <sql>CREATE FULLTEXT INDEX ft_posts_search ON posts (title, summary, content)</sql>
        <rollback>
            <sql>DROP INDEX ft_posts_search ON posts</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
